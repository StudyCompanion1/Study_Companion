# Copy this file to backend/.env (git ignores .env, so real values never get committed).

# Signs login tokens. Without it a random key is used and everyone gets logged out on every restart.
# Generate one with:  uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Defaults to a SQLite file at backend/study_companion.db. TI-1 will provide the RDS Postgres URL.
# DATABASE_URL=

# How long a login lasts, in minutes (default 1440 = 1 day).
# ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Set to true when the site is served over HTTPS (staging/production). Keep false for localhost.
# COOKIE_SECURE=false
